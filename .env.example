# =============================================================
# FeedPulse Environment Variables Template
# =============================================================
# Copy this file to .env.local for local development,
# or set these variables in your hosting provider's dashboard (e.g. Render).
# NEVER commit your actual API keys or secrets to GitHub!

# Environment
NODE_ENV=development
PORT=3000

# NextAuth Configuration
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_minimum_32_characters_long
NEXTAUTH_URL=http://localhost:3000

# Upstream Content & AI API Credentials (Optional: falls back to fixtures if omitted)
GNEWS_API_KEY=your_gnews_api_key_here
NEWS_API_KEY=your_news_api_key_here
TMDB_API_KEY=your_tmdb_api_key_or_bearer_token_here

# OpenRouter AI Provider for News Summaries & Translation
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_FALLBACK_MODELS=google/gemini-2.5-flash-lite,qwen/qwen-2.5-72b-instruct

# Storage Configuration (Optional, defaults to ./data/feedpulse.sqlite)
# For Docker or Render with persistent disk:
DATA_DIR=/app/data
# Or direct SQLite path:
# DATABASE_PATH=/var/data/feedpulse.sqlite
